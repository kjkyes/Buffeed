# Copy this file to application-local.env and fill in local/development secrets.
# Do not commit the copied .env file.
LIGHTRAG_API_KEY=replace-with-a-long-random-value
LLM_BINDING_API_KEY=replace-with-llm-api-key
EMBEDDING_BINDING_API_KEY=replace-with-embedding-api-key
VLM_LLM_BINDING_API_KEY=replace-with-vlm-api-key
RERANK_BINDING_API_KEY=replace-with-rerank-api-key

POSTGRES_HOST=replace-with-postgresql-endpoint
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATABASE=lightrag
POSTGRES_SSL_MODE=verify-full
RAG_POSTGRES_REQUIRED=true
# POSTGRES_SSL_CA_FILE=/run/secrets/aliyun-postgresql-ca.pem
# POSTGRES_SSL_ROOT_CERT=/run/secrets/aliyun-postgresql-ca.pem
