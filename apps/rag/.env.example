# Shared LightRAG server and Gateway connection settings.
# Select the profile before Docker Compose starts; do not put this in the profile file itself.
RAG_ACTIVE_PROFILE=local
# Docker Compose reads this selector before choosing the profile env file.
# Python entrypoints use the same selector.
# Optional external profile override. Do not set this when using
# config/application-${RAG_ACTIVE_PROFILE}.env inside this repository.
# RAG_PROFILE_ENV_FILE=C:\secure\rag\application-local.env
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
# LIGHTRAG_API_KEY is kept in the active profile file.
LIGHTRAG_WORKSPACE=default

# Gateway transport. Use stdio for debugging or streamable-http for shared agents.
RAG_MCP_TRANSPORT=streamable-http
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8001
RAG_MCP_PATH=/mcp
# The desktop REST facade shares the Gateway process and port at /api/v1/rag.
# Keep origins on localhost/file-mode Electron only; do not use a wildcard here.
RAG_WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,null

# Docker Compose keeps Gateway, LightRAG, Docling, and the worker on an
# internal network. Only the Gateway and Docling ports bind to localhost.
# Environment-specific credentials belong in the untracked active profile file.
RAG_APP_IMAGE=local-rag:dev
RAG_INGEST_HOST_DIR=./inputs
# Put the Alibaba Cloud CA bundle here as aliyun-postgresql-ca.pem. Compose
# mounts this directory read-only at /run/secrets for services using PostgreSQL.
RAG_SECRETS_HOST_DIR=./secrets
# Archive files from rag-backup appear here; replicate this directory to OSS.
RAG_BACKUP_HOST_DIR=./rag_backups
RAG_LOG_LEVEL=INFO
RAG_METRICS_SAMPLE_SIZE=512

# Gateway limits. RAG_INGEST_ROOTS uses the platform path separator.
RAG_INGEST_ROOTS=D:\\path\\to\\documents
RAG_QUERY_CONCURRENCY=4
RAG_REQUEST_TIMEOUT_SECONDS=120
RAG_MAX_TOP_K=20
RAG_MAX_CHUNK_TOP_K=20
RAG_MAX_TOTAL_TOKENS=12000
RAG_MAX_RETURN_CHARS=30000
RAG_MAX_FIELD_CHARS=6000
RAG_MAX_EVIDENCE_ITEMS=20
RAG_MAX_UPLOAD_BYTES=104857600

# LightRAG API server storage and parser.
HOST=127.0.0.1
PORT=9621
WORKING_DIR=./rag_storage_v154
INPUT_DIR=./inputs
# Direct worker defaults. Docker Compose overrides both paths with the shared
# LightRAG named volumes so the worker can only read completed sidecars and GraphML.
RAG_LIGHTRAG_SIDECAR_ROOT=./inputs
RAG_GRAPH_WORKING_DIR=./rag_storage_v154
# Keep originals and parser artifacts in durable storage. PostgreSQL stores only
# their URIs and index metadata; it must not become the artifact payload store.
RAG_SOURCE_URI_ROOT=file:///srv/rag/source
RAG_PARSED_URI_ROOT=file:///srv/rag/parsed
LIGHTRAG_PARSER=pdf:docling;docx:docling;pptx:docling;xlsx:docling;md:docling;html:docling;xhtml:docling;png:docling;jpg:docling;jpeg:docling;tiff:docling;webp:docling;bmp:docling
# Docker Compose defaults to this pinned CPU image. Override it only for a verified GPU image.
DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu@sha256:12b550c3e25fca7ffbba0db602482b11fcf6c400d6a9b628d0c1ba7157dced75
DOCLING_PORT=5001
DOCLING_ENDPOINT=http://127.0.0.1:5001
RAG_DOCLING_HEALTH_TIMEOUT_SECONDS=10
RAG_READINESS_TIMEOUT_SECONDS=15
MAX_PARALLEL_PARSE_DOCLING=2
# rag_ingest processing_profile adds only an upload filename hint:
# text=docling-R, visual=docling-iR, table=docling-tR, full=docling-iteR.
# i/t/e enable VLM analysis; F/R/V/P are mutually exclusive chunking strategies.
VLM_PROCESS_ENABLE=true
# Keep MinerU for isolated A/B workspaces only; production remains Docling.

# Alibaba Cloud PostgreSQL + pgvector persistence. Provision the managed
# instance separately, enable the vector extension there, and keep the
# credentials only in the untracked active profile file. POSTGRES_WORKSPACE is intentionally
# omitted so the LightRAG request workspace remains the isolation boundary.
# POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE, and
# certificate paths belong in the active profile file.
POSTGRES_PORT=5432
# Override the automatic storage-based decision only for an intentional
# local/no-PostgreSQL profile.
RAG_POSTGRES_REQUIRED=true
# Use hostname and certificate verification in production. Set the CA path when
# Alibaba Cloud provides a private bundle; Compose can mount it at /run/secrets.
POSTGRES_SSL_MODE=verify-full
# POSTGRES_SSL_CA_FILE and POSTGRES_SSL_ROOT_CERT belong in the active profile.
POSTGRES_CONNECT_TIMEOUT_SECONDS=15
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=64
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# The default pgvector image does not bundle Apache AGE. Keep graph facts in
# rag.graph_facts until an AGE-capable PostgreSQL image is deployed, then set
# this to PGGraphStorage after verifying CREATE EXTENSION AGE succeeds.
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage

# Durable file/object-storage mount used by the P2 registry. Each source and
# parser sidecar is stored below document_id/revision; do not point this at
# rag_storage_v154 or the original input directory.
RAG_ARTIFACT_ROOT=./rag_artifacts
RAG_PRODUCTION_WORKSPACE=default
RAG_PRODUCTION_ARTIFACT_NAMESPACE=production

# Office page routing uses the LibreOffice `soffice` executable in the RAG
# worker image. Conversion output is cached below RAG_VISUAL_FALLBACK_CACHE_ROOT.
RAG_OFFICE_CONVERSION_ENABLED=true
RAG_OFFICE_CONVERTER=soffice
RAG_OFFICE_CONVERSION_TIMEOUT_SECONDS=180

# P4 durable worker. Keep one worker per LightRAG workspace unless its pipeline
# concurrency and cancellation behavior have been separately validated.
# RAG_WORKER_ID=rag-worker-1
RAG_WORKER_POLL_SECONDS=5
RAG_WORKER_LEASE_SECONDS=300
RAG_WORKER_RETRY_BASE_SECONDS=10
RAG_WORKER_RETRY_MAX_SECONDS=300
RAG_WORKER_MAX_ATTEMPTS=5
RAG_WORKER_ALLOW_PIPELINE_CANCEL=true
RAG_WORKER_LOG_LEVEL=INFO

# P3 hybrid retrieval. It is enabled for the cloud deployment template; set
# both switches to false only when intentionally using the legacy LightRAG
# data endpoint without PostgreSQL FTS or registry graph facts.
RAG_HYBRID_ENABLED=true
RAG_HYBRID_POSTGRES_ENABLED=true
RAG_HYBRID_FTS_CONFIG=simple
RAG_HYBRID_PER_CHANNEL_LIMIT=24
RAG_HYBRID_FINAL_LIMIT=12
RAG_HYBRID_RRF_K=60
RAG_HYBRID_RERANK_ENABLED=true
# Query rewriting keeps the original query and optionally adds one rewrite.
# The default uses LLM_BINDING_HOST, LLM_BINDING_API_KEY, and QUERY_LLM_MODEL.
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=15
# RAG_QUERY_REWRITE_BASE_URL=https://your-openai-compatible-endpoint/v1
# RAG_QUERY_REWRITE_MODEL=your-query-model
# RAG_QUERY_REWRITE_API_KEY=replace-with-query-api-key

# Base model provider. Keep secrets only in the untracked active profile file.
LLM_BINDING=openai
LLM_BINDING_HOST=http://127.0.0.1:8000/v1
# LLM_BINDING_API_KEY belongs in the active profile file.
LLM_MODEL=replace-me
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:8000/v1
# EMBEDDING_BINDING_API_KEY belongs in the active profile file.
EMBEDDING_MODEL=replace-me
EMBEDDING_DIM=1024
ENTITY_EXTRACTION_USE_JSON=true

# Optional per-role overrides.
EXTRACT_LLM_MODEL=replace-with-fast-non-thinking-model
KEYWORD_LLM_MODEL=replace-with-low-latency-model
QUERY_LLM_MODEL=replace-with-strong-model
VLM_LLM_MODEL=replace-with-vision-model
# The visual fallback reuses VLM_LLM_BINDING_HOST/API_KEY/MODEL by default.
# Set RAG_VISUAL_FALLBACK_VLM_* only when page transcription needs another provider.

# DashScope reranker. Set RERANK_BINDING_HOST only for a private compatible endpoint.
RERANK_BINDING=aliyun
# RERANK_BINDING_HOST and RERANK_BINDING_API_KEY belong in the active profile file.
RERANK_MODEL=gte-rerank-v2
